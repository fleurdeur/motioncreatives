{
	"name": "motioncreatives",
	"compatibility_date": "2026-10-09",
	"main": "./_worker.js",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shins-library",
			"database_id": "f481a715-7eb5-4833-ab6e-606a7a3c94c9"
		},
		{
			"binding": "shins_library",
			"database_name": "shins-library",
			"database_id": "f481a715-7eb5-4833-ab6e-606a7a3c94c9",
			"remote": true
		}
	],
	"vars": {
		"ADMIN_EMAILS": "xshiinnnnn@gmail.com"
	}
}